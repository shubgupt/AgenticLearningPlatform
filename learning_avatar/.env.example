# Copy this file to .env and fill in your own paths/key. Never commit the
# real .env -- it's already in .gitignore. Each teammate should point
# PROJECT_ROOT_DIR / PROJECT_PYTHON / PYTHONPATH at their own local clone;
# the app itself doesn't require them (it computes its own paths), but they
# match the convention our other projects use for shell/IDE setup.

#
# Since most of our projects will need this configuration
# utility, this fixes the directory where to find them.
#
export PROJECT_ROOT_DIR="/path/to/your/clone/LearningAvatar/learning_avatar"

#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="/path/to/your/clone/LearningAvatar/learning_avatar/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main learning_avatar library code
# is in the src/ sub-directory
#
export PYTHONPATH="/path/to/your/clone/LearningAvatar/learning_avatar/src"

# The OpenAI Key (Replace with your own key)
export OPENAI_API_KEY=openai_api_key

# Optional overrides -- config.yaml sets sane defaults for all of these,
# uncomment only if you want an env var to win over config.yaml.
# export TEACHING_AGENT_MODEL=gpt-4o-mini
# export ASSESSMENT_AGENT_MODEL=gpt-4o-mini
# export WORKER_MODEL=gpt-4o-mini
# export LLM_MODE=mock
